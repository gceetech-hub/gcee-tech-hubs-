# GCEE Tech Hub — environment configuration
# Copy this file to `.env` / `.env.local` (gitignored) and fill in real values,
# or configure the same keys in your Vercel dashboard for production.

# ── MongoDB (REQUIRED) ───────────────────────────────────────────────
# Real Atlas connection string only. Never commit a filled-in .env.
# Example: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/gcee-tech-hub?retryWrites=true&w=majority
MONGODB_URI=

# ── Email architecture (STRICT provider separation) ──────────────────
#
# SITE_EMAIL is the ONE official email address of the club website.
# It is the default sender identity (Gmail "From"), the Contact-Us
# recipient, and the address displayed across the site. Override
# GMAIL_USER / CONTACT_RECIPIENT_EMAIL only if they must differ.
SITE_EMAIL=gceetech@gmail.com
#
# 1) NORMAL WEBSITE EMAILS  → Nodemailer → Gmail SMTP → gceetech@gmail.com
#    (registration, verification/OTP, password reset, event confirmations,
#     notifications, admin/student announcements, bulk email, etc.)
#
#    GMAIL_USER must be the club Gmail account. GMAIL_APP_PASSWORD is a
#    Google **App Password** (NOT the normal Gmail password):
#    Google Account → Security → 2-Step Verification → App passwords.
GMAIL_USER=gceetech@gmail.com
GMAIL_APP_PASSWORD=your-16-char-google-app-password

# Optional: force the sending provider ("auto" | "gmail" | "resend"; default auto).
# EMAIL_PROVIDER=auto
# Optional: use a non-Gmail SMTP server (default smtp.gmail.com:465, secure=true).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true

# 2) CONTACT US FORM ONLY   → Resend API → gceetech@gmail.com
#    Never route Contact Us through Nodemailer; never route normal website
#    emails through Resend.
#
#    Resend: https://resend.com -> API Keys.
#    RESEND_FROM_EMAIL should be an address on a domain VERIFIED in your
#    Resend account (resend.com/domains). With an unverified domain, Resend
#    only delivers to your own account email ("testing mode").
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@gceetechhub.in
RESEND_FROM_NAME=GCEE Tech Hub

# Where Contact Us (Resend) notifications are delivered.
CONTACT_RECIPIENT_EMAIL=gceetech@gmail.com

# Optional shared secret for the dev-only email test endpoint
# (/api/dev/test-email). Requests must send header: x-test-token: <secret>.
# The dev endpoints are never mounted when NODE_ENV=production.
EMAIL_TEST_SECRET=

# ── Auth ─────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@gceetechhub.in
ADMIN_PASSWORD=change-me
ADMIN_NAME=GCEE Tech Hub Admin

# ── App URLs (used for links inside emails like REGISTER NOW button) ──
APP_URL=https://gcee-tech-hub-phi.vercel.app
CLIENT_URL=https://gcee-tech-hub-phi.vercel.app
NEXT_PUBLIC_APP_URL=https://gcee-tech-hub-phi.vercel.app
VITE_APP_URL=https://gcee-tech-hub-phi.vercel.app

# ── Optional: force DNS resolvers for Mongo SRV lookups ──────────────
# Set when your system resolver refuses SRV queries (e.g. 8.8.8.8,1.1.1.1).
# FORCE_DNS=

# ── Optional: Google Form webhook shared secret ──────────────────────
# GOOGLE_FORM_WEBHOOK_SECRET=
